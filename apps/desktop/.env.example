HITECHCLOUD_AUTH_BASE_URL=https://api.hitechcloud.vn
HITECHCLOUD_AUTH_SIGN_IN_URL=https://www.hitechcloud.vn/signin
HITECHCLOUD_BACKEND_BASE_URL=https://api.hitechcloud.vn
HITECHCLOUD_DESKTOP_CONTROL_PLANE_BASE_URL=https://api.hitechcloud.vn/gateway/sandbox

# Web frontend origin that hosts web HolaApp pages (need-review, ...) — NOT an
# api host. Web HolaApp surfaces load from <origin>/apps/<holaAppId>.
#   prod    https://www.hitechcloud.vn
#   staging https://www.imerchstaging.com
HITECHCLOUD_WEB_APP_BASE_URL=https://www.hitechcloud.vn

# Optional: where web HolaApp MCP servers are reached (SSE at
# <base>/mcp/<holaAppId>/sse). Defaults to HITECHCLOUD_BACKEND_BASE_URL — only set
# this if the app MCPs live on a different host than the backend/gateway.
# HITECHCLOUD_WEB_HOLAAPP_MCP_BASE_URL=https://api.hitechcloud.vn

# Sentry error tracking (optional, leave empty to disable)
# SENTRY_DSN=
