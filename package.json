{
  "name": "hitechcloudos",
  "packageManager": "bun@1.3.6",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "node scripts/remove-paths.mjs out apps/desktop/build runtime/out",
    "dev": "bun run desktop:dev",
    "docs:dev": "npm --prefix apps/docs run dev",
    "docs:test": "npm --prefix apps/docs run types:check && npm --prefix apps/docs run build",
    "docs:typecheck": "npm --prefix apps/docs run types:check",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:preview": "npm --prefix apps/docs run start",
    "docs:deploy:staging": "npm --prefix apps/docs run deploy:staging",
    "docs:deploy:production": "npm --prefix apps/docs run deploy:production",
    "desktop:clean": "node scripts/remove-paths.mjs apps/desktop/out apps/desktop/build",
    "desktop:install": "bun install",
    "desktop:prepare": "bun --filter=@hitechcloud/app-sdk run build",
    "desktop:dev": "bun --elide-lines=0 --filter=hitechcloud-local run dev",
    "desktop:dev:isolated": "node scripts/desktop-dev-isolated.mjs",
    "desktop:e2e": "bun --filter=hitechcloud-local run e2e",
    "desktop:typecheck": "bun --filter=hitechcloud-local run typecheck",
    "desktop:prepare-runtime": "bun --filter=hitechcloud-local run prepare:runtime",
    "desktop:prepare-runtime:local": "bun --filter=hitechcloud-local run prepare:runtime:local",
    "desktop:dist:mac:local": "bun --filter=hitechcloud-local run dist:mac:local",
    "desktop:dist:win:local": "bun --filter=hitechcloud-local run dist:win:local",
    "memory:cleanup": "node scripts/memory-cleanup.mjs",
    "memory:eval": "node scripts/memory-eval.mjs",
    "runtime:start:isolated": "node scripts/runtime-start-isolated.mjs",
    "runtime:logs": "bash scripts/runtime-logs.sh",
    "runtime:start:evals": "node scripts/runtime-start-isolated.mjs --namespace evals --default-name memory-evals",
    "runtime:harnesses:install": "bun install",
    "runtime:harness-host:install": "bun install",
    "runtime:harness-host:build": "bun --filter=@hitechcloud/runtime-harness-host run build",
    "runtime:harness-host:test": "bun --filter=@hitechcloud/runtime-harness-host run test",
    "runtime:harness-host:typecheck": "bun --filter=@hitechcloud/runtime-harness-host run typecheck",
    "runtime:state-store:install": "bun install",
    "runtime:state-store:build": "bun --filter=@hitechcloud/runtime-state-store run build",
    "runtime:state-store:test": "bun --filter=@hitechcloud/runtime-state-store run test",
    "runtime:state-store:typecheck": "bun --filter=@hitechcloud/runtime-state-store run typecheck",
    "runtime:api-server:install": "bun install",
    "runtime:api-server:build": "bun --filter=@hitechcloud/runtime-api-server run build",
    "runtime:api-server:test": "bun --filter=@hitechcloud/runtime-api-server run test",
    "runtime:api-server:typecheck": "bun --filter=@hitechcloud/runtime-api-server run typecheck",
    "runtime:clean": "node scripts/remove-paths.mjs out/runtime-linux out/runtime-macos out/runtime-windows out/runtime-root runtime/out",
    "runtime:harnesses:test": "bun --filter=@hitechcloud/runtime-harnesses run test",
    "runtime:test": "bun --filter=@hitechcloud/runtime-state-store run test && bun --filter=@hitechcloud/runtime-harnesses run test && bun --filter=@hitechcloud/runtime-harness-host run test && bun --filter=@hitechcloud/runtime-api-server run test",
    "sdk:app-sdk:install": "bun install",
    "sdk:app-sdk:build": "bun --filter=@hitechcloud/app-sdk run build",
    "sdk:app-sdk:test": "bun --filter=@hitechcloud/app-sdk run test",
    "sdk:app-sdk:typecheck": "bun --filter=@hitechcloud/app-sdk run typecheck",
    "sdk:app-sdk:codegen": "bun --filter=@hitechcloud/app-sdk run codegen",
    "runtime:rebuild-sqlite": "node scripts/ensure-native-sqlite.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "trustedDependencies": [
    "@electron/rebuild",
    "@parcel/watcher",
    "better-sqlite3",
    "electron",
    "electron-builder",
    "esbuild",
    "sharp"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/app-builder-sdk/reference/*/playground",
    "runtime/api-server",
    "runtime/channel-gateway",
    "runtime/harness-host",
    "runtime/harnesses",
    "runtime/state-store"
  ]
}
